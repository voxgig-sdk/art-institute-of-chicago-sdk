# Entity: product

main: kit: entity: product: {

  alias: field: {}

  fields: [
    {
      name: "api_link"
      req: false
      type: "`$ANY`"
    }
    {
      name: "api_model"
      req: false
      type: "`$ANY`"
    }
    {
      name: "artist_id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "artwork_id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "description"
      req: false
      type: "`$STRING`"
    }
    {
      name: "exhibition_id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "external_sku"
      req: false
      type: "`$ANY`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "image_url"
      req: false
      type: "`$ANY`"
    }
    {
      name: "max_compare_at_price"
      req: false
      type: "`$ANY`"
    }
    {
      name: "max_current_price"
      req: false
      type: "`$ANY`"
    }
    {
      name: "min_compare_at_price"
      req: false
