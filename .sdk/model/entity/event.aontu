  }

  name: "event"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /events"
            source: "openapi3"
            version: 2
          }
          m: "GET"
          o: "/events"
          s: [
            {
              lit: "events"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /events/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/events/{id}"
          q: {
            exist: [
              "id"
            ]
          }
          s: [
            {
              lit: "events"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
