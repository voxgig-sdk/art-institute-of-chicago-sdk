  name: "image"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /images"
            source: "openapi3"
            version: 2
          }
          m: "GET"
          o: "/images"
          s: [
            {
              lit: "images"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /images/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
