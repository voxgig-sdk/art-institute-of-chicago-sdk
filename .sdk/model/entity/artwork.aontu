  name: "artwork"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /artworks"
            source: "openapi3"
            version: 2
          }
          m: "GET"
          o: "/artworks"
          s: [
            {
              lit: "artworks"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /artworks/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/artworks/{id}"
          q: {
            exist: [
              "id"
            ]
          }
          s: [
            {
              lit: "artworks"
            }
            {
              var: "id"
            }
          ]
          t: {
