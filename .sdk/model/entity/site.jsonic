# Entity: site

main: kit: entity: site: {

  alias: field: {}

  fields: [
    {
      name: "api_link"
      req: false
      type: "`$ANY`"
    }
    {
      name: "api_model"
      req: false
      type: "`$ANY`"
    }
    {
      name: "artwork_id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "artwork_title"
      req: false
      type: "`$ANY`"
    }
    {
      name: "description"
      req: false
      type: "`$STRING`"
    }
    {
      name: "exhibition_id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "exhibition_title"
      req: false
      type: "`$ANY`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "source_updated_at"
      req: false
      type: "`$ANY`"
    }
    {
      name: "suggest_autocomplete_all"
      req: false
      type: "`$ANY`"
    }
    {
      name: "suggest_autocomplete_boosted"
      req: false
      type: "`$ANY`"
    }
    {
      name: "timestamp"
      req: false
      type: "`$ANY`"
    }
    {
      name: "title"
      req: false
      type: "`$STRING`"
    }
    {
      name: "updated_at"
      req: false
      type: "`$ANY`"
    }
    {
      name: "web_url"
      req: false
      type: "`$ANY`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "site"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/sites"
          parts: [
            "sites"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/sites/{id}"
          parts: [
            "sites"
            "{id}"
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
