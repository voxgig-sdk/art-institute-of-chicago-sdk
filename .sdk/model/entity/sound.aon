  name: "sound"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/mobile-sounds"
          parts: [
            "mobile-sounds"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "GET"
          orig: "/sounds"
