# BasicStaticPageFlow

main: kit: flow: BasicStaticPageFlow:
{
  entity: "static_page",
  kind: "basic",
  name: "BasicStaticPageFlow",
  step: [
    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "static_page_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "static_page_ref01",
        srcdatavar: "static_page_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "static_page01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-static_page_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicStaticPageFlow"
}