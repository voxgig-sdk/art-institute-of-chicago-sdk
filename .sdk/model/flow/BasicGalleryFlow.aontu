# BasicGalleryFlow

main: kit: flow: BasicGalleryFlow:
{
  entity: "gallery",
  kind: "basic",
  name: "BasicGalleryFlow",
  step: [
    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "gallery_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "gallery_ref01",
        srcdatavar: "gallery_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "gallery01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-gallery_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicGalleryFlow"
}